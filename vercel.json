{
  "version": 2,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "node_modules/@mathjax/**/mjs/**,node_modules/mhchemparser/**,node_modules/mhchem/**",
      "excludeFiles": "node_modules/@mathjax/**/*.{woff2,otf}"
    }
  }
}
