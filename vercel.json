{
  "version": 2,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": [
        "node_modules/@mathjax/mathjax-newcm-font/mjs/**",
        "node_modules/@mathjax/mathjax-tex-font/mjs/**"
      ],
      "excludeFiles": "node_modules/@mathjax/**/*.{woff2,otf}"
    }
  }
}
